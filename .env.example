# Telegram bot tokeni (@BotFather dan olinadi). Hech kimga bermang.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot egasining Telegram ID si (vergul bilan ko'p bo'lishi mumkin).
# Admin buyruqlari (/oilalar, /uzaytir ...) va cheksiz obuna shu ID larga beriladi.
# O'z ID ingizni @userinfobot dan bilib olasiz.
ALLOWED_USERS=123456789

# Ixtiyoriy: admin ID lar. Bo'sh qolsa ALLOWED_USERS dagilar admin hisoblanadi.
# ADMIN_IDS=123456789

# Ixtiyoriy: yangi oila uchun bepul sinov muddati (kun). 0 bo'lsa sinov yo'q.
# TRIAL_DAYS=7

# Ixtiyoriy: bitta oiladagi a'zolar soni chegarasi.
# MAX_MEMBERS=6

# Ixtiyoriy: obuna tugagan foydalanuvchiga ko'rsatiladigan aloqa matni.
# CONTACT_TEXT=To'lov va obuna uchun @sizning_username ga yozing.

# Ixtiyoriy: narxlar haqida matn (oila bo'limida ko'rinadi).
# PRICE_TEXT=Oylik obuna: 30 000 so'm

# Ixtiyoriy: kunlik eslatma vaqti (Asia/Tashkent), standart 21:00
# REMINDER_TIME=21:00

# Ixtiyoriy: baza fayli joyi, standart data/budget.db
# DB_PATH=data/budget.db

# Ixtiyoriy: bot holati xabari yangilanish oralig'i (soniya). Standart 60, kamida 10, 0 = o'chirish.
# Telegram juda tez tahrirlashni cheklaydi, 3 soniya tavsiya etilmaydi.
# STATUS_INTERVAL=60
